    "construire": "vite build"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@cucumber/cucumber": "^13.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "playwright": "1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "7.3.7",
    "vitest": "^4.0.0",
    "wrangler": "^4.157.0"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.13.16",
    "jose": "^6.2.15",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  }
}
