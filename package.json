{
  "name": "crazybrain",
  "private": true,
  "type": "module",
  "scripts": {
    "verifier-types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json && tsc --noEmit -p tsconfig.ui.json",
    "test": "vitest run",
    "test:acceptation": "npm run construire && NODE_OPTIONS=\"--import tsx\" cucumber-js",
