// Worker de Crazybrain : l'API (src/, routes /api/*) et l'interface (construite par Vite de ui/ vers dist/), avec la base D1.
// Pas d'adresse de secours en workers.dev : le site ne vit que sur son sous-domaine, que
// Cloudflare Access ferme (connexion Google ; posé par smalldek/cluster, vérifié à chaque déploiement).
// Le Worker vérifie en plus le jeton d'Access sur chaque appel /api/* (deuxième serrure).
// Exception (décision 003) : le connecteur Claude (/mcp) et les adresses OAuth que les serveurs
// d'Anthropic appellent sont ouverts dans Access ; /mcp exige alors un jeton OAuth du Worker.
{
	"name": "crazybrain",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"assets": {
		// L'interface construite par `npm run construire` (Vite) ; dist/ n'est pas dans git.
		"directory": "./dist",
		// Une adresse de l'interface qui n'est pas un fichier (/e/<id>, l'adresse d'un élément) rend
		// index.html : c'est React qui lit l'adresse et ouvre le bon écran.
		"not_found_handling": "single-page-application",
		// Ces adresses passent par le code ; le reste est servi tel quel depuis dist/.
		"run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/authorize", "/token", "/register", "/.well-known/*"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "crazybrain",
			// L'identifiant réel est écrit par le déploiement (deployer.yml), jamais commité.
			"database_id": "REMPLACE_AU_DEPLOIEMENT",
			"migrations_dir": "migrations"
		}
	],
	"kv_namespaces": [
		{
			// Clients, autorisations et jetons OAuth du connecteur (jetons rangés hachés).
			// Identifiant réel écrit par le déploiement, jamais commité.
			"binding": "OAUTH_KV",
			"id": "REMPLACE_AU_DEPLOIEMENT_KV"
		}
	],
	"vars": {
		// L'adresse publique : l'identité du connecteur OAuth (ressource et émetteur des jetons).
		"ORIGINE": "https://crazybrain.dekermadec.net",
		// L'équipe Cloudflare Access qui signe les jetons (pas un secret). L'AUD, propre à
		// l'application Access, est passée au déploiement (--var AUD:…), pas écrite ici.
		"TEAM_DOMAIN": "https://2ker-consulting.cloudflareaccess.com"
	},
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{ "pattern": "crazybrain.dekermadec.net", "custom_domain": true }
	]
}
